{
    "compilerOptions": {
        "checkJs": true,
        "allowJs": true,
        "noEmit": true,
        "strict": true,
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "ES2022",
        "lib": ["ES2022"],
        "types": ["node"],
        "skipLibCheck": true,
        "maxNodeModuleJsDepth": 0
    },
    "include": ["bin/**/*.js", "src/**/*.js"]
}
